#!/usr/bin/env bash
set -euo pipefail

usage() {
  echo "usage: leetcode [-local | -claude | -anthropic | -openai | -chatgpt]" >&2
  echo "  leetcode             start the companion with the provider chosen on the extension's" >&2
  echo "                       settings page (Claude subscription if nothing is saved yet)" >&2
  echo "  leetcode -<provider> use that provider for this run only (sets COMPANION_BACKEND," >&2
  echo "                       which locks the provider on the settings page while it runs)" >&2
}

if [ "$#" -eq 0 ]; then
  : # no override: the saved settings (or their default) decide
elif [ "$#" -eq 1 ]; then
  case "$1" in
    -local | -claude | -anthropic | -openai | -chatgpt)
      export COMPANION_BACKEND="${1#-}"
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      usage
      exit 1
      ;;
  esac
else
  usage
  exit 1
fi

source="${BASH_SOURCE[0]}"
while [ -h "$source" ]; do
  target="$(readlink "$source")"
  case "$target" in
    /*) source="$target" ;;
    *) source="$(dirname "$source")/$target" ;;
  esac
done
script_dir="$(cd "$(dirname "$source")" && pwd)"
cd "$script_dir/../companion"
exec node companion.js
