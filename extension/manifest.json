{
  "manifest_version": 3,
  "name": "LeetCode Capture",
  "version": "0.1.1",
  "description": "Captures live LeetCode editor attempts on Run/Submit and relays them to a local logging server.",
  "content_scripts": [
    {
      "matches": ["https://leetcode.com/problems/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "http://localhost:8135/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["inject.js"],
      "matches": ["https://leetcode.com/*"]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "leetcode-capture@thomsonklee.dev",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["websiteContent"],
        "optional": []
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
