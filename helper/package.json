{
  "name": "leetcode-capture-helper",
  "version": "0.1.0",
  "description": "Native Messaging helper for LeetCode Capture: lets the browser extension start and stop the local companion and relay for the Claude and ChatGPT subscriptions. The package carries its own copy of the companion and relay.",
  "type": "module",
  "bin": {
    "leetcode-capture-helper": "cli.js"
  },
  "files": [
    "cli.js",
    "config.js",
    "framing.js",
    "host.js",
    "install.js",
    "runtime/"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test framing.test.js host.test.js install.test.js pack.test.js",
    "prepack": "node scripts/pack.mjs",
    "postpack": "node scripts/pack.mjs --clean",
    "e2e:packed": "node e2e/packed.e2e.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.233",
    "chalk": "^5.6.2",
    "marked": "^15.0.12",
    "marked-terminal": "^7.3.0"
  },
  "license": "MIT"
}
